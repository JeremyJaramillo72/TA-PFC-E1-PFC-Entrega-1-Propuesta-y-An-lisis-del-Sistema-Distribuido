        <mxCell id="e_gw_perfiles" value="Enruta gestión de perfiles&lt;br&gt;[gRPC / mTLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;fontColor=#1A1A1A;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c_gateway" target="ms_perfiles">

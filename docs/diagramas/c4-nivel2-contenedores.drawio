  <diagram id="c4-contenedores-bolsa-uteq" name="C4 Nivel 2 - Contenedores">
    <mxGraphModel dx="1420" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titulo -->
        <mxCell id="title" value="&lt;b&gt;Diagrama de Contenedores (C4 Nivel 2) — Bolsa de Empleos para Graduados UTEQ&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="380" y="15" width="800" height="30" as="geometry" />
        </mxCell>

        <!-- ACTORES -->
        <mxCell id="p_graduado" value="&lt;b&gt;Graduado UTEQ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Gestiona perfil, busca vacantes&lt;br&gt;y registra postulaciones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="220" y="60" width="250" height="95" as="geometry" />
        </mxCell>

        <mxCell id="p_empresa" value="&lt;b&gt;Empresa Colaboradora&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Publica ofertas laborales y&lt;br&gt;gestiona postulantes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="655" y="60" width="250" height="95" as="geometry" />
        </mxCell>

        <mxCell id="p_admin" value="&lt;b&gt;Administrador UTEQ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Valida ofertas, gestiona usuarios&lt;br&gt;y consulta auditoría." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1090" y="60" width="250" height="95" as="geometry" />
        </mxCell>

        <!-- FRONTERA DEL SISTEMA -->
        <mxCell id="boundary_sys" value="&lt;b&gt;Bolsa de Empleos para Graduados UTEQ&lt;/b&gt; &lt;font style=&quot;font-size:11px;&quot;&gt;[Límite del Sistema Distribuido]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;strokeColor=#0B4884;fillColor=none;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontColor=#0B4884;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="1480" height="560" as="geometry" />
        </mxCell>

        <!-- CONTENEDORES DE ENTRADA -->
        <mxCell id="c_webapp" value="&lt;b&gt;Aplicación Web (Frontend)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[Contenedor: SPA Web]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Interfaz única responsiva para graduados, empresas y administradores." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="265" width="360" height="85" as="geometry" />
        </mxCell>

        <mxCell id="c_gateway" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[Contenedor: REST / Enrutamiento y RBAC]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Punto único de entrada, control de acceso por roles (RBAC) y enrutamiento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="425" width="360" height="85" as="geometry" />
        </mxCell>

        <!-- MICROSERVICIOS -->
        <mxCell id="ms_perfiles" value="&lt;b&gt;Servicio de Perfiles&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[Contenedor: Microservicio Python / gRPC]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Gestiona hojas de vida, verifica estatus institucional y expone &lt;i&gt;VerificarElegibilidad&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="615" width="260" height="125" as="geometry" />
        </mxCell>

        <mxCell id="ms_postulaciones" value="&lt;b&gt;Servicio de Postulaciones&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[Contenedor: Microservicio Python / gRPC]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Registra postulaciones, evita duplicados y valida elegibilidad en tiempo real." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="510" y="615" width="260" height="125" as="geometry" />
        </mxCell>

        <mxCell id="ms_ofertas" value="&lt;b&gt;Servicio de Ofertas y Scraping&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[Contenedor: Microservicio / Recolector]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Administra vacantes de empresas, validación UTEQ e importación de portales externos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="615" width="260" height="125" as="geometry" />
        </mxCell>

        <mxCell id="ms_notificaciones" value="&lt;b&gt;Servicio de Notificaciones&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;[Contenedor: Microservicio Asíncrono]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Procesa alertas personalizadas de vacantes y envío de códigos 2FA." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1210" y="615" width="260" height="125" as="geometry" />
        </mxCell>

        <!-- CONEXIONES SINCRONAS -->
